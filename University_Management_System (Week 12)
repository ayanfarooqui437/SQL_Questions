CREATE DATABASE UniversityDB;

USE UniversityDB;
CREATE TABLE University(
    UID INT PRIMARY KEY,
    UName VARCHAR(50),
    City VARCHAR(30),
    Location VARCHAR(50)
);
CREATE TABLE Department(
    DID INT PRIMARY KEY,
    DName VARCHAR(50),
    UID INT,
    HOD VARCHAR(50),
    FOREIGN KEY(UID) REFERENCES University(UID)
);

CREATE TABLE Program(
    PID INT PRIMARY KEY,
    PName VARCHAR(50),
    Duration INT,
    DID INT,
    FOREIGN KEY(DID) REFERENCES Department(DID)
);
CREATE TABLE Course(
    CID INT PRIMARY KEY,
    CName VARCHAR(50),
    Credits INT,
    PID INT,
    FOREIGN KEY(PID) REFERENCES Program(PID)
);
CREATE TABLE Syllabus(
    SID INT PRIMARY KEY,
    Topic VARCHAR(50),
    Semester INT,
    CID INT,
    FOREIGN KEY(CID) REFERENCES Course(CID)
);
CREATE TABLE Faculty(
    FID INT PRIMARY KEY,
    FName VARCHAR(50),
    Specialization VARCHAR(50),
    UID INT,
    FOREIGN KEY(UID) REFERENCES University(UID)
);
