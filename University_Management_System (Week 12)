SELECT * FROM University
WHERE City='Delhi';

SELECT DName
FROM Department
WHERE UID=1;

SELECT Location
FROM University
WHERE UName='JNU';

SELECT P.PName
FROM Program P
JOIN Department D ON P.DID=D.DID
JOIN University U ON D.UID=U.UID
WHERE U.UName='JU';

SELECT DISTINCT U.UName
FROM University U
JOIN Department D ON U.UID=D.UID
JOIN Program P ON D.DID=P.DID
WHERE P.PName='MCA';

SELECT C.CName
FROM Course C
JOIN Program P ON C.PID=P.PID
JOIN Department D ON P.DID=D.DID
JOIN University U ON D.UID=U.UID
WHERE P.PName='MCA'
AND U.UName='AMU';

SELECT F.FName,U.UName
FROM Faculty F
JOIN University U ON F.UID=U.UID
WHERE F.Specialization='Information Security';

SELECT U.UName,S.Topic
FROM Syllabus S
JOIN Course C ON S.CID=C.CID
JOIN Program P ON C.PID=P.PID
JOIN Department D ON P.DID=D.DID
JOIN University U ON D.UID=U.UID
WHERE C.CName='Computer Architecture';
